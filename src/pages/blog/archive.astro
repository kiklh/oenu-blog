---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	formatArchiveTags,
	formatMonthDay,
	groupByYear,
} from "@utils/archive-utils";
import { getSortedPostsList } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";

// 归档全部在构建期渲染成静态 HTML：搜索引擎与禁用 JS 的环境都能读到完整列表。
// 历史上的 ?tag= / ?category= / ?uncategorized= 由页面底部的脚本做行级显隐。
const posts = await getSortedPostsList();
const groups = groupByYear(posts);
const total = posts.length;
---

<MainGridLayout title={i18n(I18nKey.archive)}>

    <div class="card-base px-6 md:px-8 py-6 mb-4 onload-animation">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-2xl font-bold text-90">{i18n(I18nKey.archive)}</h2>
                <p class="text-sm text-50 mt-1">
                    共 {total} 篇 · 跨 {groups.length} 个年份
                </p>
            </div>
            <div class="flex flex-wrap gap-2">
                {groups.map((group) => (
                    <a
                        href={`#year-${group.year}`}
                        data-year-chip={group.year}
                        class="btn-plain h-8 px-3 rounded-full text-sm font-bold"
                    >
                        {group.year}
                    </a>
                ))}
            </div>
        </div>

        <div data-archive-filter-banner class="hidden mt-4 flex-wrap items-center gap-2 text-sm">
            <span class="text-50">当前筛选：</span>
            <span data-filter-chip class="h-7 px-3 rounded-full inline-flex items-center font-bold
                bg-[var(--btn-regular-bg)] text-[var(--primary)]"></span>
            <button type="button" data-filter-clear
                    class="btn-plain h-7 px-3 rounded-full text-sm font-bold">
                清除筛选
            </button>
        </div>
    </div>

    <div class="card-base px-6 md:px-8 py-6" data-pagefind-ignore>
        {groups.map((group) => (
            <section data-archive-group data-year={group.year}>
                <div class="flex flex-row w-full items-center h-[3.75rem]">
                    <div id={`year-${group.year}`}
                         class="w-[20%] md:w-[10%] transition text-2xl font-bold text-right text-75 scroll-mt-24">
                        {group.year}
                    </div>
                    <div class="w-[14%] md:w-[10%]">
                        <div class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto
                            -outline-offset-[2px] z-50 outline-3"></div>
                    </div>
                    <div class="w-[66%] md:w-[80%] transition text-left text-50" data-group-count>
                        <span>{group.posts.length}</span>
                        {" "}
                        {i18n(group.posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}
                    </div>
                </div>

                {group.posts.map((post) => (
                    <a
                        href={getPostUrlBySlug(post.slug)}
                        aria-label={post.data.title}
                        data-archive-row
                        data-year={group.year}
                        data-tags={post.data.tags.join("|")}
                        data-category={post.data.category ?? ""}
                        class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
                    >
                        <div class="flex flex-row justify-start items-center h-full">
                            <div class="w-[20%] md:w-[10%] transition text-sm text-right text-50">
                                {formatMonthDay(post.data.published)}
                            </div>

                            <div class="w-[14%] md:w-[10%] relative dash-line h-full flex items-center">
                                <div class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5
                                    bg-[oklch(0.5_0.05_var(--hue))] group-hover:bg-[var(--primary)]
                                    outline outline-4 z-50
                                    outline-[var(--card-bg)]
                                    group-hover:outline-[var(--btn-plain-bg-hover)]
                                    group-active:outline-[var(--btn-plain-bg-active)]"></div>
                            </div>

                            <div class="w-[66%] md:max-w-[65%] md:w-[65%] text-left font-bold
                                group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)]
                                text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden">
                                {post.data.title}
                            </div>

                            <div class="hidden md:block md:w-[15%] text-left text-sm transition
                                whitespace-nowrap overflow-ellipsis overflow-hidden text-30">
                                {formatArchiveTags(post.data.tags)}
                            </div>
                        </div>
                    </a>
                ))}
            </section>
        ))}
    </div>
</MainGridLayout>

<script>
    import {
        isFilterActive,
        readArchiveFilter,
        type ArchiveFilter,
    } from "@utils/archive-utils";

    // 只做「按 URL 参数显隐已有节点」，不重建 DOM：
    // 因此这段脚本被 swup 重复执行也是幂等的，没有副作用累积。
    function describeFilter(filter: ArchiveFilter): string {
        const parts: string[] = [];
        for (const tag of filter.tags) parts.push(`#${tag}`);
        for (const category of filter.categories) parts.push(category);
        if (filter.uncategorized) parts.push("未分类");
        return parts.join(" · ");
    }

    function applyArchiveFilter() {
        const filter = readArchiveFilter(window.location.search);
        const active = isFilterActive(filter);

        const rows = document.querySelectorAll<HTMLElement>("[data-archive-row]");
        const groups = document.querySelectorAll<HTMLElement>("[data-archive-group]");
        const chips = document.querySelectorAll<HTMLElement>("[data-year-chip]");
        const banner = document.querySelector<HTMLElement>("[data-archive-filter-banner]");
        const chip = document.querySelector<HTMLElement>("[data-filter-chip]");

        const visibleByYear = new Map<string, number>();

        for (const row of rows) {
            const tags = (row.dataset.tags ?? "").split("|").filter(Boolean);
            const category = row.dataset.category ?? "";

            let visible = true;
            if (filter.tags.length > 0) {
                visible = tags.some((tag) => filter.tags.includes(tag));
            }
            if (visible && filter.categories.length > 0) {
                visible = filter.categories.includes(category);
            }
            if (visible && filter.uncategorized) {
                visible = category === "";
            }

            row.classList.toggle("hidden", !visible);
            if (visible) {
                const year = row.dataset.year ?? "";
                visibleByYear.set(year, (visibleByYear.get(year) ?? 0) + 1);
            }
        }

        for (const group of groups) {
            const year = group.dataset.year ?? "";
            const count = visibleByYear.get(year) ?? 0;
            group.classList.toggle("hidden", count === 0);

            const counter = group.querySelector<HTMLElement>("[data-group-count] span");
            if (counter) counter.textContent = String(count);
        }

        for (const yearChip of chips) {
            const year = yearChip.dataset.yearChip ?? "";
            yearChip.classList.toggle("hidden", (visibleByYear.get(year) ?? 0) === 0);
        }

        if (banner && chip) {
            banner.classList.toggle("hidden", !active);
            banner.classList.toggle("flex", active);
            chip.textContent = describeFilter(filter);
        }
    }

    function bindClear() {
        document.querySelector("[data-filter-clear]")?.addEventListener("click", () => {
            window.history.replaceState(null, "", window.location.pathname);
            applyArchiveFilter();
        });
    }

    applyArchiveFilter();
    bindClear();
</script>
