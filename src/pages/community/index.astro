---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { communityConfig } from "@/modules/community/config";
import { url } from "@utils/url-utils";

const { entries, forumStatus } = communityConfig;
---

<MainGridLayout title="社区" description="讨论、提问与反馈的入口">
    <div class="card-base px-6 md:px-9 py-8 relative w-full mb-4 onload-animation">
        <div class="flex items-center gap-3 mb-3">
            <Icon name="material-symbols:forum-outline-rounded" class="text-[2rem] text-[var(--primary)]"></Icon>
            <h1 class="text-2xl font-bold text-90">社区</h1>
        </div>
        <p class="text-75 text-sm leading-7">
            这里的讨论暂时都放在 GitHub Discussions：用 GitHub 账号就能发起话题，不需要再注册一个站内账号。
        </p>
        {forumStatus === "planned" && (
            <p class="text-50 text-sm mt-3">
                站内论坛正在规划中，上线后这个入口会一并切换，届时不需要记新的地址。
            </p>
        )}
    </div>

    <div class="flex flex-col gap-4">
        {entries.map((entry, index) => (
            <a
                href={entry.external ? entry.url : url(entry.url)}
                target={entry.external ? "_blank" : null}
                rel={entry.external ? "noopener noreferrer" : null}
                class="card-base group px-6 md:px-9 py-6 flex items-start gap-4 onload-animation transition hover:bg-[var(--btn-plain-bg-hover)] active:scale-[0.995]"
                style={`animation-delay: calc(var(--content-delay) + ${index * 60}ms);`}
            >
                <div class="w-11 h-11 shrink-0 rounded-lg bg-[var(--btn-regular-bg)] text-[var(--primary)] flex items-center justify-center transition group-hover:bg-[var(--btn-plain-bg-active)]">
                    <Icon name={entry.icon} class="text-[1.5rem]"></Icon>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 font-bold text-90 mb-1">
                        {entry.name}
                        {entry.external && (
                            <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.75rem] text-black/25 dark:text-white/25"></Icon>
                        )}
                    </div>
                    <div class="text-sm text-75 leading-6 mb-2">{entry.description}</div>
                    <div class="text-sm font-bold text-[var(--primary)]">
                        {entry.cta}
                        <Icon name="material-symbols:arrow-right-alt-rounded" class="inline text-[1.1rem] transition group-hover:translate-x-1 align-[-3px]"></Icon>
                    </div>
                </div>
            </a>
        ))}
    </div>
</MainGridLayout>
