---
import { Icon } from "astro-icon/components";
import { commentConfig } from "@/config";

const cfg = commentConfig;

// 这里只输出标记，不含任何 <script>：
// 挂载/懒加载/主题同步/失败兜底全部由 scripts/comments.ts 负责（由 Layout 引入一次）。
const enabled = cfg.enable && Boolean(cfg.repoId) && Boolean(cfg.categoryId);
---

{enabled && (
    <div
        class="card-base px-6 md:px-9 py-6 relative w-full mb-4 onload-animation"
        data-comments-card
        data-state="idle"
        data-pagefind-ignore
    >
        <div class="flex items-center gap-2 font-bold text-lg text-90 mb-4">
            <Icon name="fa6-solid:comments" class="text-[1.1rem] text-[var(--primary)]"></Icon>
            讨论
            <span class="text-50 text-xs font-normal ml-1">由 GitHub Discussions 提供</span>
        </div>

        <div class="giscus-shell">
            <div class="giscus-skeleton" aria-hidden="true">
                <div class="skeleton-row">
                    <div class="skeleton-avatar"></div>
                    <div class="skeleton-lines">
                        <div class="skeleton-line" style="width: 32%"></div>
                        <div class="skeleton-line" style="width: 78%"></div>
                    </div>
                </div>
                <div class="skeleton-row">
                    <div class="skeleton-avatar"></div>
                    <div class="skeleton-lines">
                        <div class="skeleton-line" style="width: 26%"></div>
                        <div class="skeleton-line" style="width: 64%"></div>
                    </div>
                </div>
            </div>

            <div
                class="giscus"
                data-comments-host
                data-repo={cfg.repo}
                data-repo-id={cfg.repoId}
                data-category={cfg.category}
                data-category-id={cfg.categoryId}
                data-mapping={cfg.mapping}
                data-strict={cfg.strict ? "1" : "0"}
                data-reactions-enabled={cfg.reactionsEnabled ? "1" : "0"}
                data-emit-metadata="0"
                data-input-position={cfg.inputPosition}
                data-lang={cfg.lang}
            >
            </div>
        </div>

        <noscript>
            <p class="text-75 text-sm">
                评论区需要 JavaScript。也可以直接前往
                <a class="text-[var(--primary)] underline" href={cfg.discussionsUrl}>GitHub Discussions</a>
                参与讨论。
            </p>
        </noscript>

        <div data-comments-fallback class="hidden">
            <p class="text-75 text-sm leading-7">
                评论加载超时或失败（可能是网络无法访问 giscus.app）。
                <button
                    type="button"
                    data-comments-retry
                    class="btn-plain h-7 px-3 rounded-lg text-sm font-bold align-middle"
                >
                    重试一次
                </button>
                <span class="text-30 mx-1">/</span>
                <a
                    class="text-[var(--primary)] font-bold underline"
                    href={cfg.discussionsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    在 GitHub 上查看讨论
                </a>
            </p>
        </div>
    </div>
)}
