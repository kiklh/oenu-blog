{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fuwari-blog",
	"compatibility_date": "2026-11-17",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "oenu.kdns.fr",
			"custom_domain": true
		}
	]
}
